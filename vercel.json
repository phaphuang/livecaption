{
  "version": 2,
  "functions": {
    "api/session.py": {
      "maxDuration": 30
    },
    "api/transcribe.py": {
      "maxDuration": 30
    },
    "api/translate.py": {
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/api/session", "dest": "/api/session.py" },
    { "src": "/api/transcribe", "dest": "/api/transcribe.py" },
    { "src": "/api/translate", "dest": "/api/translate.py" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
